# React Native CLI build-time configuration (react-native-config).
# Android emulator or a physical phone with ADB reverse can use localhost.
# For Wireless debugging, forward host ports 8000 (Laravel) and 8081 (Metro)
# to the selected phone; see the real-device instructions in README.md.
# This value is bundled into the app; do not put API secrets here.
API_URL=http://127.0.0.1:8000/api/v1
